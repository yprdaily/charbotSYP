ENV=dev

CORS_ORIGINS=
CORS_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$

JWT_ISSUER=corpbot
JWT_AUDIENCE=corpbot-users
JWT_TTL_SECONDS=300
JWT_SIGNING_KEY_BASE64=dummy_jwt_signing_key_base64_for_local_dev

USER_HASH_SALT=dummy_user_hash_salt_for_local_dev

ADMIN_TOKEN=dummy_admin_token_for_local_dev
CACHE_TTL_SECONDS=3600

VERSION_CELL_A1=E1
DATA_RANGE_A1=A:F

# 繝ｭ繝ｼ繧ｫ繝ｫ縺ｧSA JSON繧剃ｽｿ縺・↑繧峨√％縺薙↓繝輔ぃ繧､繝ｫ繝代せ
GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\corpbot-sa.json

